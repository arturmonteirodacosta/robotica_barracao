// Pinos MH-Sensor-Seria
const int sensorEsquerdo = A0; // Pino analógico para o sensor IR esquerdo
const int sensorMeio = A1; // Pino analógico para o sensor IR esquerdo
const int sensorDireito = A2; // Pino analógico para o sensor IR direito

// Pinos Ponte-H
const int ENA = 7;
const int IN1 = 2; // Controle de direção motor esquerdo
const int IN2 = 3; // Controle de direção motor esquerdo
const int ENB = 6;
const int IN3 = 4; // Controle de direção motor direito
const int IN4 = 5; // Controle de direção motor direito

//artur: aumentei o limiar por causa da media
const int limiar = 600; // Limiar para distinguir branco (alto) de preto (baixo)
float erro, numerador, denominador;
// Variáveis
float valorEsquerdo, valorMeio, valorDireito;
//artur: adicionei essas variaveis
int lastLeft = 0, lastRight = 0;
// velocidade 
int vel = 255; // ajuste entre 0 e 255

// Função de setup
void setup() {
    Serial.begin(9600);
    // Configura os pinos dos sensores como entrada
    pinMode(sensorEsquerdo, INPUT);
    pinMode(sensorDireito, INPUT);
    pinMode(sensorMeio, INPUT);
    // Configura os pinos da ponte H como saída
    pinMode(ENA, OUTPUT);
    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);
    pinMode(ENB, OUTPUT);
    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);
}
// Função principal de loop
