// Função para ir para frente
void frente() {
    // Motor esquerdo para frente
    analogWrite(ENA, vel);
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    // Motor direito para frente
    analogWrite(ENB, vel);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
    Serial.print("- Frente");
}
// Função para virar à esquerda (parar motor esquerdo, motor direito para frente)
//Artur: aqui tá errado, não tá parando o motor, tá girando ele pra trás, parar é low low
void viraDireita() {
    // Motor esquerdo parado
    analogWrite(ENA, vel/2);
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    // Motor direito para frente
    analogWrite(ENB, vel);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
    Serial.print("- ViraEsquerda");
}
// Função para virar à direita (motor esquerdo para frente, motor direito parado)
void viraEsquerda() {
    // Motor esquerdo para frente
    analogWrite(ENA, vel);
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    // Motor direito parado
    analogWrite(ENB, vel/2);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    Serial.print("- ViraDireita");
}
// Função para parar
void parar() {
    // Ambos motores parados
    analogWrite(ENA, 0);
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    analogWrite(ENB, 0);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
    Serial.print("- Parar");
}
void Re() {
    // Motor esquerdo para frente
    analogWrite(ENA, vel);
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    // Motor direito para frente
    analogWrite(ENB, vel);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    //Serial.print("- Frente");
}
void mostrar(){
    Serial.print("\nValor esquerdo: | Valor Meio: | Valor Direito: \n");
    Serial.print(valorEsquerdo);
    Serial.print("\t");
    Serial.print(valorMeio);
    Serial.print("\t");
    Serial.println(valorDireito);
    Serial.print("Posicao: ");
    Serial.println(erro);
    Serial.print("Numerador: ");
    Serial.println(numerador);
    Serial.print("Denominador: ");
    Serial.println(denominador);
    delay(1500);
}
